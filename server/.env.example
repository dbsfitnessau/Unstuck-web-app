# Copy this file to ".env" and fill in real values. ".env" is gitignored — never commit it.

# Your Anthropic API key. Lives ONLY here on the server, never in the client/browser.
# Get one at https://console.anthropic.com/ . If a key is ever pasted into a chat or
# shared, treat it as compromised and rotate it.
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model the coach uses.
#   - claude-sonnet-4-5   → good default: fast + cheaper, fine for routine coaching.
#   - claude-opus-4-8     → premium tier (named in prompt.md) — smarter, pricier.
# Swap freely without touching code.
COACH_MODEL=claude-sonnet-4-5

# Port the server listens on. The client's dev proxy points here.
PORT=8787

# Comma-separated list of browser origins allowed to call this server (CORS).
# These are the Vite dev server URLs. Add your production URL here when you deploy.
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Optional: folder holding the 4 UNSTUCK source docs. Defaults to the project root
# (one level above /server), which is where they currently live.
# DOCS_DIR=/absolute/path/to/docs
