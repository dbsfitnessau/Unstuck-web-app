# Copy this file to ".env" and fill in real values. ".env" is gitignored — never commit it.

# Your Anthropic API key. Lives ONLY here on the server, never in the client/browser.
# Get one at https://console.anthropic.com/ . If a key is ever pasted into a chat or
# shared, treat it as compromised and rotate it.
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model the coach uses.
#   - claude-sonnet-4-5   → good default: fast + cheaper, fine for routine coaching.
#   - claude-opus-4-8     → premium tier (named in prompt.md) — smarter, pricier.
# Swap freely without touching code.
COACH_MODEL=claude-sonnet-4-5

# Port the server listens on. The client's dev proxy points here.
PORT=8787

# Comma-separated list of browser origins allowed to call this server (CORS).
# These are the Vite dev server URLs. Add your production URL here when you deploy.
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# Optional: folder holding the 4 UNSTUCK source docs. Defaults to the project root
# (one level above /server), which is where they currently live.
# DOCS_DIR=/absolute/path/to/docs

# --- Hardening (all optional; sensible defaults shown) ---

# Per-request timeout for the Claude call, in milliseconds. If exceeded, the request
# aborts and the user gets the safe fallback instead of a hanging page.
# COACH_TIMEOUT_MS=60000

# Per-IP rate limit on /api/coach: max requests per window, and the window length (ms).
# COACH_RATE_MAX=12
# COACH_RATE_WINDOW_MS=60000

# Input caps: max messages in the chat history, and max characters per message.
# COACH_MAX_MESSAGES=40
# COACH_MAX_CONTENT_CHARS=4000

# Set to 1 (or the number of proxy hops) ONLY when deployed behind a reverse proxy /
# load balancer, so the rate limiter sees the real client IP. Leave unset locally.
# TRUST_PROXY=1

# Beta access gate. Comma-separated list of access codes that unlock the app. Leave EMPTY
# to turn the gate OFF (open to anyone). Give each tester their own code so you can revoke
# one without affecting the others — just edit this list and redeploy.
# BETA_ACCESS_CODES=alex-2026,sam-2026,unstuck-beta
