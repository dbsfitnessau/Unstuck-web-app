# Optional client config. Copy to ".env" only if you need to override the default.
#
# Where the coach backend lives. Leave unset for local dev — the app defaults to
# http://localhost:8787 (the Express server). Set this to your deployed server URL
# in production. NOTE: this is NOT a secret (no API key here) — the key stays on the
# server. This just tells the browser which server to call.
VITE_API_URL=http://localhost:8787

# Supabase project URL + ANON (public) key. The browser uses these for magic-link
# sign-in and cloud progress sync. These are PUBLIC by design and ARE shipped inside
# the browser bundle: the anon key is safe to expose because all access is enforced by
# Supabase Row Level Security (RLS). They are config, not secrets - do not put the
# service_role key here. Find both at: Supabase dashboard > Project Settings > API.
# (If these are unset, the app falls back to the beta access-code gate.)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
